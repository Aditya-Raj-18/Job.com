<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ATS resume templates · Job.com</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css?v=20261102-original-evergreen-1"></head><body><div class="shell"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/admin">Job<span>.com</span></a><p class="sidebar-label">ADMIN CONSOLE</p><nav class="nav-list"><a class="nav" href="${pageContext.request.contextPath}/admin">← Back to admin</a><a class="nav active" href="${pageContext.request.contextPath}/admin/resume-templates">ATS resume templates</a></nav><div class="sidebar-bottom"><strong><c:out value="${sessionScope.adminName}"/></strong></div></aside><main class="main"><header class="page-header"><div><p class="eyebrow">JOB.COM / ADMIN</p><h1>ATS resume templates</h1><p class="page-subtitle">Publish layouts for seekers. The optional PDF is a reference sample; seekers enter their own information in the editable builder.</p></div></header><c:if test="${not empty error}"><div class="alert"><c:out value="${error}"/></div></c:if><c:if test="${param.success=='1'}"><div class="success-message">Template saved. Active templates are now available in the seeker resume builder.</div></c:if><section class="content-card"><form class="panel" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf" value="${csrf}"><h2>Publish an ATS format</h2><label>Template name<input name="name" maxlength="140" placeholder="e.g. Clean Chronological ATS" required></label><label>Short description<textarea name="description" maxlength="500" placeholder="Best for early career, experienced roles, etc."></textarea></label><label>Resume layout<select name="layout"><option value="classic">Classic ATS</option><option value="compact">Compact ATS</option><option value="modern">Modern ATS</option></select></label><label>Reference format PDF (optional, max 5 MB)<input type="file" name="template" accept="application/pdf,.pdf"></label><p class="form-hint">Uploaded PDF is a downloadable example. Job seekers create their own editable resume using the chosen ATS layout.</p><button>Publish template</button></form><div class="table-wrap"><table><thead><tr><th>Template</th><th>Layout</th><th>Description</th><th>Reference PDF</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${templates}" var="t"><tr><td><strong><c:out value="${t.name}"/></strong></td><td><c:out value="${t.layout}"/></td><td><c:out value="${t.description}"/></td><td><c:if test="${not empty t.file_path}"><c:url var="pdf" value="/admin/document"><c:param name="path" value="${t.file_path}"/></c:url><a target="_blank" rel="noopener" href="${pdf}">View PDF</a></c:if></td><td><c:out value="${t.active?'Active':'Hidden'}"/></td><td><form method="post"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="action" value="toggle"><input type="hidden" name="id" value="${t.template_id}"><input type="hidden" name="active" value="${!t.active}"><button class="row-action">${t.active?'Hide':'Make available'}</button></form></td></tr></c:forEach><c:if test="${empty templates}"><tr><td colspan="6" class="empty-state">No resume templates yet. Publish one above.</td></tr></c:if></tbody></table></div></section></main></div></body></html>
