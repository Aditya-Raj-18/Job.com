<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create Job.com account</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css?v=20261102-original-evergreen-1"></head>
<body class="register-page">
<main class="register-shell">
  <a class="brand register-brand" href="${pageContext.request.contextPath}/recruiter/login">Job<span>.com</span></a>
  <section class="register-card">
    <div class="register-heading"><p class="eyebrow">JOIN JOB.COM</p><h1>Create an account</h1><p><c:choose><c:when test="${type=='seeker'}">Job Seeker</c:when><c:otherwise>Submit your details for administrator review.</c:otherwise></c:choose></p></div>
    <c:if test="${param.success=='1'}"><div class="success-message"><strong>Application submitted.</strong> Your account is pending administrator verification. <c:choose><c:when test="${type=='recruiter'}">Once your company is approved, <a href="${pageContext.request.contextPath}/recruiter/login">sign in to the recruiter dashboard</a>.</c:when><c:otherwise>Once approved, <a href="${pageContext.request.contextPath}/seeker/login">sign in here</a> to build your ATS resume.</c:otherwise></c:choose></div></c:if>
    <c:if test="${not empty error}"><div class="alert" role="alert"><c:out value="${error}"/></div></c:if>
    <div class="account-switch recruiter-only"><span class="selected"><c:choose><c:when test="${type=='seeker'}">Job Seeker</c:when><c:otherwise>Recruiter / company</c:otherwise></c:choose></span></div>
    <form method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/register">
      <input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="type" value="${type}">
      <c:if test="${type=='seeker'}">
        <h2>Personal details</h2><div class="form-grid"><label class="span-two file-field">Profile photo (JPG or PNG; max 5 MB)<input type="file" name="profilePhoto" accept=".jpg,.jpeg,.png,image/jpeg,image/png" required></label><label>Full name<input name="full_name" autocomplete="name" required></label><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Phone<input type="tel" name="phone" autocomplete="tel" inputmode="tel" maxlength="32" required></label><label>Date of birth<input type="date" name="date_of_birth"></label><label class="span-two">Address<input name="address" autocomplete="street-address"></label><label>City<input name="city" autocomplete="address-level2"></label><label>State<input name="state" autocomplete="address-level1"></label><label>Postal code<input name="postal_code" autocomplete="postal-code"></label><label>Highest qualification<input name="qualification"></label><label>Career field<select name="career_field" required><option value="">Select your career field</option><c:forEach items="${careerFields}" var="field"><option value="${field}"><c:out value="${field}"/></option></c:forEach></select></label><label>Experience (years)<input type="number" min="0" max="80" step="0.5" name="experience_years"></label></div>
        <h2>Professional profile</h2><div class="form-grid"><label class="span-two">Profile headline<input name="profile_headline" placeholder="e.g. Entry-level Java developer"></label><label class="span-two">Skills<input name="skills" placeholder="Java, SQL, communication"></label><label class="span-two">Profile summary<textarea name="profile_summary" rows="4"></textarea></label><label>LinkedIn profile<input type="url" name="linkedin_url" placeholder="https://"></label><label>Portfolio link<input type="url" name="portfolio_url" placeholder="https://"></label><label class="span-two file-field">Resume (optional PDF or DOCX; max 5 MB)<input type="file" name="resume" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"></label></div>
        <h2>Government-issued ID verification</h2><p class="form-hint">Choose an ID and upload its proof. Only the last four ID digits are stored in the profile; the full number remains visible only on the submitted document.</p><div class="form-grid"><label>ID document type<select name="government_id_type" required><option value="">Select ID type</option><option>Aadhaar Card</option><option>Passport</option><option>Voter ID</option><option>Driving Licence</option><option>PAN Card</option><option>Other government-issued ID</option></select></label><label>Last four digits<input name="government_id_last4" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required></label><label class="span-two file-field">Upload government ID proof (PDF, JPG, PNG; max 5 MB)<input type="file" name="proof" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required></label></div>
      </c:if>
      <c:if test="${type=='recruiter'}">
        <h2>Company details</h2><div class="form-grid"><label>Company name<input name="company_name" required></label><label>Legal name<input name="legal_name"></label><label>Company email<input type="email" name="email" autocomplete="email" required></label><label>Company phone<input name="phone" autocomplete="tel" required></label><label>Website<input type="url" name="website" placeholder="https://"></label><label>Industry<input name="industry"></label><label>Company size<select name="company_size"><option value="">Select size</option><option>1–10</option><option>11–50</option><option>51–200</option><option>201–500</option><option>501–1000</option><option>1000+</option></select></label><label>Company registration number<input name="company_registration_number"></label><label class="span-two">Company address<input name="address" required></label><label>City<input name="city" required></label><label>State / province<input name="state" list="state-suggestions" autocomplete="address-level1" placeholder="Start typing a state"></label><label>Country<input name="country" list="country-suggestions" autocomplete="country-name" placeholder="Start typing a country"></label><label>Postal code<input name="postal_code" autocomplete="postal-code"></label><label>Tax registration number<input name="tax_registration_number"></label></div>
        <h2>Recruiter contact</h2><div class="form-grid"><label>Recruiter / contact person<input name="contact_person" required></label><label>Designation<input name="contact_title" placeholder="HR Manager, Recruiter"></label></div>
        <h2>Business license verification</h2><p class="form-hint">Provide the company license details and upload a readable proof document for admin review.</p><div class="form-grid"><label>License number<input name="license_number" required></label><label>License type / issuing authority<input name="license_type" required></label><label class="span-two file-field">Upload company license (PDF, JPG, PNG; max 5 MB)<input type="file" name="proof" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required></label></div>
      </c:if>
      <h2>Secure your account</h2><label class="password-field">Password <span>at least 12 characters</span><input type="password" name="password" minlength="12" autocomplete="new-password" required></label>
      <div class="register-actions"><button type="submit">Submit for verification</button></div>
      <p class="form-footnote">Your account will remain pending until an administrator reviews the submitted information and document.</p>
    </form>
  </section>
  <div class="ats-popup-overlay" id="registrationAtsPopup" hidden><section class="ats-popup-card" role="dialog" aria-modal="true" aria-labelledby="registrationAtsTitle"><button class="ats-popup-close" id="registrationAtsClose" type="button" aria-label="Close ATS score">×</button><p class="eyebrow">RESUME CHECK</p><h2 id="registrationAtsTitle">ATS readiness estimate</h2><div class="ats-score-result" id="registrationAtsResult" aria-live="polite"></div><p class="ats-popup-caption">This score popup closes automatically in 10 seconds.</p></section></div>
</main>
<script>
(() => {const input=document.querySelector('input[name="resume"]'),box=document.getElementById('registrationAtsResult'),popup=document.getElementById('registrationAtsPopup'),close=document.getElementById('registrationAtsClose');if(!input||!box||!popup)return;let timer;const hide=()=>{clearTimeout(timer);popup.hidden=true};close.addEventListener('click',hide);popup.addEventListener('click',event=>{if(event.target===popup)hide()});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&!popup.hidden)hide()});input.addEventListener('change',async()=>{clearTimeout(timer);hide();box.replaceChildren();if(!input.files.length)return;box.textContent='Checking resume…';popup.hidden=false;try{const data=new FormData();data.append('resume',input.files[0]);const response=await fetch('${pageContext.request.contextPath}/ats-score',{method:'POST',body:data});const result=await response.json();if(!response.ok)throw new Error(result.error||'Could not check this resume.');box.replaceChildren();const title=document.createElement('strong');title.textContent='ATS readiness estimate: '+result.score+'/100';box.appendChild(title);const breakdown=document.createElement('div');breakdown.className='ats-score-breakdown';Object.entries(result.breakdown).forEach(([label,points])=>{const row=document.createElement('div');row.textContent=label+': '+points+' pts';breakdown.appendChild(row)});box.appendChild(breakdown);const list=document.createElement('ul');result.suggestions.slice(0,5).forEach(item=>{const li=document.createElement('li');li.textContent=item;list.appendChild(li)});box.appendChild(list)}catch(error){box.textContent=error.message}timer=setTimeout(hide,10000)})})();
</script>
<datalist id="state-suggestions"></datalist>
<datalist id="country-suggestions"></datalist>
<script>
(() => {
  const countryInput = document.querySelector('input[name="country"]');
  const stateInput = document.querySelector('input[name="state"]');
  if (!countryInput || !stateInput) return;

  const countries = `Afghanistan|Albania|Algeria|Andorra|Angola|Antigua and Barbuda|Argentina|Armenia|Australia|Austria|Azerbaijan|Bahamas|Bahrain|Bangladesh|Barbados|Belarus|Belgium|Belize|Benin|Bhutan|Bolivia|Bosnia and Herzegovina|Botswana|Brazil|Brunei|Bulgaria|Burkina Faso|Burundi|Cambodia|Cameroon|Canada|Cape Verde|Central African Republic|Chad|Chile|China|Colombia|Comoros|Costa Rica|Croatia|Cuba|Cyprus|Czechia|Democratic Republic of the Congo|Denmark|Djibouti|Dominica|Dominican Republic|Ecuador|Egypt|El Salvador|Equatorial Guinea|Eritrea|Estonia|Eswatini|Ethiopia|Fiji|Finland|France|Gabon|Gambia|Georgia|Germany|Ghana|Greece|Grenada|Guatemala|Guinea|Guinea-Bissau|Guyana|Haiti|Honduras|Hungary|Iceland|India|Indonesia|Iran|Iraq|Ireland|Israel|Italy|Jamaica|Japan|Jordan|Kazakhstan|Kenya|Kiribati|Kuwait|Kyrgyzstan|Laos|Latvia|Lebanon|Lesotho|Liberia|Libya|Liechtenstein|Lithuania|Luxembourg|Madagascar|Malawi|Malaysia|Maldives|Mali|Malta|Marshall Islands|Mauritania|Mauritius|Mexico|Micronesia|Moldova|Monaco|Mongolia|Montenegro|Morocco|Mozambique|Myanmar|Namibia|Nauru|Nepal|Netherlands|New Zealand|Nicaragua|Niger|Nigeria|North Korea|North Macedonia|Norway|Oman|Pakistan|Palau|Panama|Papua New Guinea|Paraguay|Peru|Philippines|Poland|Portugal|Qatar|Republic of the Congo|Romania|Russia|Rwanda|Saint Kitts and Nevis|Saint Lucia|Saint Vincent and the Grenadines|Samoa|San Marino|Sao Tome and Principe|Saudi Arabia|Senegal|Serbia|Seychelles|Sierra Leone|Singapore|Slovakia|Slovenia|Solomon Islands|Somalia|South Africa|South Korea|South Sudan|Spain|Sri Lanka|Sudan|Suriname|Sweden|Switzerland|Syria|Taiwan|Tajikistan|Tanzania|Thailand|Timor-Leste|Togo|Tonga|Trinidad and Tobago|Tunisia|Turkey|Turkmenistan|Tuvalu|Uganda|Ukraine|United Arab Emirates|United Kingdom|United States|Uruguay|Uzbekistan|Vanuatu|Vatican City|Venezuela|Vietnam|Yemen|Zambia|Zimbabwe`.split('|');
  const stateSets = {
    india: `Andhra Pradesh|Arunachal Pradesh|Assam|Bihar|Chhattisgarh|Goa|Gujarat|Haryana|Himachal Pradesh|Jharkhand|Karnataka|Kerala|Madhya Pradesh|Maharashtra|Manipur|Meghalaya|Mizoram|Nagaland|Odisha|Punjab|Rajasthan|Sikkim|Tamil Nadu|Telangana|Tripura|Uttar Pradesh|Uttarakhand|West Bengal|Andaman and Nicobar Islands|Chandigarh|Dadra and Nagar Haveli and Daman and Diu|Delhi|Jammu and Kashmir|Ladakh|Lakshadweep|Puducherry`,
    'united states': `Alabama|Alaska|Arizona|Arkansas|California|Colorado|Connecticut|Delaware|Florida|Georgia|Hawaii|Idaho|Illinois|Indiana|Iowa|Kansas|Kentucky|Louisiana|Maine|Maryland|Massachusetts|Michigan|Minnesota|Mississippi|Missouri|Montana|Nebraska|Nevada|New Hampshire|New Jersey|New Mexico|New York|North Carolina|North Dakota|Ohio|Oklahoma|Oregon|Pennsylvania|Rhode Island|South Carolina|South Dakota|Tennessee|Texas|Utah|Vermont|Virginia|Washington|West Virginia|Wisconsin|Wyoming|District of Columbia`,
    canada: `Alberta|British Columbia|Manitoba|New Brunswick|Newfoundland and Labrador|Northwest Territories|Nova Scotia|Nunavut|Ontario|Prince Edward Island|Quebec|Saskatchewan|Yukon`,
    australia: `Australian Capital Territory|New South Wales|Northern Territory|Queensland|South Australia|Tasmania|Victoria|Western Australia`,
    'united kingdom': `England|Northern Ireland|Scotland|Wales`,
    nepal: `Bagmati|Gandaki|Karnali|Koshi|Lumbini|Madhesh|Sudurpashchim`
  };
  const countryList = document.getElementById('country-suggestions');
  const stateList = document.getElementById('state-suggestions');
  countries.forEach(name => countryList.append(new Option(name, name)));
  function updateStates() {
    const key = countryInput.value.trim().toLowerCase();
    const values = stateSets[key] || (key ? [] : stateSets.india);
    stateList.replaceChildren(...values.split('|').filter(Boolean).map(name => new Option(name, name)));
  }
  countryInput.addEventListener('input', updateStates);
  updateStates();
})();
</script>
</body>
</html>
