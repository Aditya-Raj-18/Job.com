<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ATS score checker · Job.com</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css?v=20261102-original-evergreen-1"><style>
.ats-checker{max-width:900px;margin:32px auto;background:#fff;border:1px solid #dce7e3;border-radius:18px;padding:clamp(22px,4vw,38px);box-shadow:0 15px 38px #193b3210}.ats-checker h2{margin:0 0 8px;color:#173d39}.ats-checker p{color:#63766f;line-height:1.6}.ats-checker form{display:grid;gap:12px;margin-top:24px}.ats-checker input[type=file]{padding:16px;border:1px solid #d6e4de;border-radius:12px;background:#f7fbf8;font:inherit;border-style:dashed}.ats-checker label{font-size:13px;font-weight:700;color:#344b60}.ats-checker button{justify-self:start;border:0;border-radius:9px;padding:12px 18px;background:#087b6d;color:white;font:inherit;font-weight:750;cursor:pointer}.ats-score-result{margin-top:17px;padding:16px;border-radius:12px;background:#edf8f2;border:1px solid #c9e9d7;color:#1f654a}.ats-score-result>strong{font-size:19px}.ats-score-result ul{padding-left:20px}.ats-score-breakdown{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:7px;margin:12px 0}.ats-score-breakdown div{display:flex;justify-content:space-between;gap:10px;padding:8px 10px;background:#fff;border:1px solid #dcebe2;border-radius:8px;font-size:12px}.ats-score-note{font-size:12px!important}
</style></head><body><div class="shell seeker-shell seeker-shell-no-sidebar"><main class="main seeker-main"><%@ include file="account-menu.jspf" %><header class="page-header"><div><p class="eyebrow">JOB.COM / CAREER TOOLS</p><h1>ATS score checker</h1></div></header><section class="ats-checker"><h2>Upload a resume</h2><form id="atsScoreForm" enctype="multipart/form-data"><label for="atsResumeFile">Resume file</label><input id="atsResumeFile" name="resume" type="file" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required><button type="submit">Check ATS score</button></form><div class="ats-score-result" id="atsScoreResult" aria-live="polite" hidden></div><p class="ats-score-note">This is a transparent resume-readiness estimate. Different employers configure their applicant tracking systems differently, so no score can guarantee a screening result.</p></section></main></div><script>
(()=>{const form=document.getElementById('atsScoreForm'),result=document.getElementById('atsScoreResult');form.addEventListener('submit',async event=>{event.preventDefault();result.hidden=false;result.textContent='Checking your resume…';try{const response=await fetch('${pageContext.request.contextPath}/ats-score',{method:'POST',body:new FormData(form)}),data=await response.json();if(!response.ok)throw new Error(data.error||'Could not check this resume.');result.replaceChildren();const title=document.createElement('strong');title.textContent='ATS readiness estimate: '+data.score+'/100';result.appendChild(title);const breakdown=document.createElement('div');breakdown.className='ats-score-breakdown';Object.entries(data.breakdown).forEach(([label,points])=>{const row=document.createElement('div'),name=document.createElement('span'),value=document.createElement('strong');name.textContent=label;value.textContent=points+' pts';row.append(name,value);breakdown.appendChild(row)});result.appendChild(breakdown);const list=document.createElement('ul');data.suggestions.forEach(item=>{const li=document.createElement('li');li.textContent=item;list.appendChild(li)});result.appendChild(list)}catch(error){result.textContent=error.message}})})();
</script></body></html>
