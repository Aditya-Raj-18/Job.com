<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Company workspace · Job.com</title>
  <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css?v=20261102-original-evergreen-1">
  <style>
    .recruiter-workspace{max-width:1480px}.recruiter-panel{margin:0 0 24px}.workspace-heading{display:flex;align-items:end;justify-content:space-between;gap:16px;margin:0 0 16px}.workspace-heading h2{margin:3px 0}.workspace-heading p{margin:0;color:#718095}.workspace-actions{display:flex;flex-wrap:wrap;align-items:center;gap:10px}.workspace-button{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:9px;padding:11px 15px;background:#137c72;color:#fff;font:inherit;font-weight:700;text-decoration:none;cursor:pointer}.workspace-button:disabled{opacity:1;cursor:default}.workspace-button.secondary{background:#e9f5f1;color:#116a62}.workspace-button.danger{background:#fff0ec;color:#b54a2c}.workspace-job-list{display:grid;gap:12px}.workspace-job,.applicant-card{background:#fff;border:1px solid #dbe7e2;border-radius:16px;padding:20px;box-shadow:0 12px 32px rgba(20,55,50,.04)}.workspace-job-top{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}.workspace-job h3,.applicant-card h3{margin:0 0 8px;font-size:21px}.workspace-job h3 a,.applicant-card h3 a{color:#142d42;text-decoration:none}.workspace-job h3 a:hover,.applicant-card h3 a:hover{color:#147a70}.workspace-job p{margin:6px 0;color:#6d7b8e}.workspace-job-meta{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.workspace-job-meta span{border-radius:999px;padding:6px 10px;background:#eef5f3;color:#41645f;font-size:13px}.workspace-delete{display:inline}.workspace-delete button{font:inherit}.job-form-grid,.applicant-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.job-form-grid label,.applicant-detail-grid div{display:grid;gap:6px;color:#56657b;font-size:13px;font-weight:700}.job-form-grid .field-wide,.applicant-detail-grid .field-wide{grid-column:1/-1}.job-form-grid input,.job-form-grid select,.job-form-grid textarea{box-sizing:border-box;width:100%;padding:11px 12px;border:1px solid #d7e3de;border-radius:9px;color:#203735;background:#fff;font:inherit}.applicant-detail-grid div{padding:12px;border-bottom:1px solid #e7eeeb}.applicant-detail-grid strong{color:#203735;font-size:15px;font-weight:600;overflow-wrap:anywhere}.applicant-detail-grid a{color:#12796f}.applicant-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:22px}.applicant-actions form{margin:0}.applicant-actions .workspace-button,.selected-message-form .workspace-button{min-height:46px;padding:12px 18px;font-size:14px;font-weight:800;box-shadow:0 2px 5px rgba(18,45,66,.12)}.applicant-actions .status-accept{background:#08766c;color:#fff}.applicant-actions .status-reject{background:#b9382b;color:#fff}.applicant-actions .status-hired{background:#20643c;color:#fff}.applicant-actions .status-accept:hover{background:#075b54}.applicant-actions .status-reject:hover{background:#922c22}.applicant-actions .status-hired:hover{background:#174d2e}.workspace-button:focus-visible,.selected-message-form textarea:focus-visible{outline:3px solid #162d47;outline-offset:3px}.applicant-card{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:12px}.applicant-card p{margin:3px 0;color:#718095}.workspace-table td a{color:#11756b;font-weight:700;text-decoration:none}.workspace-empty{padding:32px;text-align:center;color:#718095;background:#fff;border:1px dashed #cddbd5;border-radius:16px}.job-edit-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:20px}.selected-message-form{display:grid;gap:10px;margin:0 0 20px;padding:20px;background:#edf7f4;border:1px solid #b9ddd3;border-radius:14px}.selected-message-form label{font-size:15px;font-weight:800;color:#173d39}.selected-message-form p{margin:0;color:#3e605b;font-size:13px;line-height:1.5}.selected-message-form textarea{box-sizing:border-box;width:100%;min-height:110px;padding:13px;border:1px solid #98beb4;border-radius:9px;background:#fff;color:#173d39;font:inherit;resize:vertical}.selected-message-form .workspace-button{justify-self:start;background:#075f57;color:#fff}.status-note{color:#718095;font-size:14px}
    @media(max-width:760px){.workspace-heading,.workspace-job-top,.applicant-card,.job-edit-toolbar{align-items:stretch;flex-direction:column}.job-form-grid,.applicant-detail-grid{grid-template-columns:1fr}.job-form-grid .field-wide,.applicant-detail-grid .field-wide{grid-column:auto}.applicant-actions{display:grid}.applicant-actions form,.applicant-actions button{width:100%}}
  </style>
</head>
<body>
<div class="shell recruiter-shell">
  <aside class="sidebar">
    <a class="brand" href="${pageContext.request.contextPath}/recruiter">Job<span>.com</span></a>
    <p class="sidebar-label">COMPANY WORKSPACE</p>
    <nav class="nav-list">
      <a class="nav ${view=='dashboard'?'active':''}" href="${pageContext.request.contextPath}/recruiter"><span class="nav-icon">▦</span>Dashboard</a>
      <a class="nav ${view=='my-jobs' || view=='job-detail'?'active':''}" href="${pageContext.request.contextPath}/recruiter?section=my-jobs"><span class="nav-icon">▤</span>My Jobs</a>
      <a class="nav ${view=='applicants' || view=='applicant-list' || view=='applicant-detail'?'active':''}" href="${pageContext.request.contextPath}/recruiter?section=applicants"><span class="nav-icon">♙</span>Applicants</a>
      <a class="nav ${view=='selected-applicants'?'active':''}" href="${pageContext.request.contextPath}/recruiter?section=selected-applicants"><span class="nav-icon">✓</span>Selected applicants</a>
      <a class="nav ${view=='profile'?'active':''}" href="${pageContext.request.contextPath}/recruiter?section=profile"><span class="nav-icon">◉</span>Company profile</a>
      <a class="nav ${view=='post-job'?'active':''}" href="${pageContext.request.contextPath}/recruiter?section=post-job"><span class="nav-icon">＋</span>Post a job</a>
      <a class="nav" href="${pageContext.request.contextPath}/recruiter/support"><span class="nav-icon">?</span>Help &amp; support</a>
      <c:if test="${not empty chats}"><a class="nav" href="${pageContext.request.contextPath}/chat"><span class="nav-icon">✉</span>Chats</a></c:if>
    </nav>
    <div class="sidebar-bottom"><div class="admin-mini"><span class="avatar">C</span><div><strong><c:out value="${companyName}"/></strong><small>Recruiter account</small></div></div><a class="nav logout" href="${pageContext.request.contextPath}/recruiter/login?logout=1">Sign out</a></div>
  </aside>
  <main class="main recruiter-main recruiter-workspace">
    <header class="page-header"><div><p class="eyebrow">JOB.COM <span>/</span> COMPANY</p>
      <h1><c:choose><c:when test="${view=='my-jobs'}">My Jobs</c:when><c:when test="${view=='job-detail'}">Job details</c:when><c:when test="${view=='applicants'}">Applicants</c:when><c:when test="${view=='applicant-list'}">Applicants for this job</c:when><c:when test="${view=='applicant-detail'}">Applicant details</c:when><c:when test="${view=='selected-applicants'}">Selected applicants</c:when><c:when test="${view=='profile'}">Company profile</c:when><c:when test="${view=='post-job'}">Post a job</c:when><c:otherwise>Company dashboard</c:otherwise></c:choose></h1>
      <p class="page-subtitle"><c:choose><c:when test="${view=='my-jobs'}">Your posted jobs. Open a listing to edit it or remove it.</c:when><c:when test="${view=='job-detail'}">Review and update the details on your listing.</c:when><c:when test="${view=='applicants'}">Choose a job to review its applicants.</c:when><c:when test="${view=='applicant-list'}">Select an applicant to review their complete profile and application.</c:when><c:when test="${view=='applicant-detail'}">Review the applicant and update their hiring status.</c:when><c:when test="${view=='selected-applicants'}">Manage applicants you accepted and mark successful candidates as hired.</c:when><c:when test="${view=='profile'}">View your company and business verification details.</c:when><c:when test="${view=='post-job'}">Submit a job opening for administrator review.</c:when><c:otherwise>Check your company account and hiring workspace.</c:otherwise></c:choose></p>
    </div><div class="signed-in"><span class="online-dot"></span>Signed in: <strong><c:out value="${companyName}"/></strong></div></header>
    <c:if test="${not empty error}"><div class="alert" role="alert"><c:out value="${error}"/></div></c:if>
    <c:if test="${not empty sessionScope.recruiterFlashSuccess}"><div class="success-message"><c:out value="${sessionScope.recruiterFlashSuccess}"/></div><c:remove var="recruiterFlashSuccess" scope="session"/></c:if>
    <c:if test="${not empty sessionScope.recruiterFlashError}"><div class="alert" role="alert"><c:out value="${sessionScope.recruiterFlashError}"/></div><c:remove var="recruiterFlashError" scope="session"/></c:if>

    <c:if test="${view=='dashboard' and not empty profile}">
      <div class="welcome-panel recruiter-welcome"><div><p class="welcome-kicker">WELCOME BACK</p><h2><c:out value="${profile.name}"/></h2><p>Your company workspace for job posts and profile details.</p></div><img class="welcome-illustration" src="${pageContext.request.contextPath}/assets/images/recruiter-hiring.svg" alt="Animated illustration of a hiring team reviewing candidates"></div>
      <div class="review-note"><span class="review-note-icon">i</span><div><strong>Account review status: <c:out value="${profile.status}"/></strong><br>Company accounts must be approved by Job.com before job listings can be published to job seekers. New job posts are also reviewed by the administrator.</div></div>
    </c:if>
    <c:if test="${view=='dashboard' and not empty announcements}"><section class="seeker-section"><div class="section-heading"><div><p class="eyebrow">JOB.COM UPDATES</p><h2>Announcements</h2></div></div><div class="notification-list"><c:forEach items="${announcements}" var="announcement"><article class="notification-card"><div class="notification-card-top"><h3><c:out value="${announcement.name}"/></h3><span class="status-pill"><c:out value="${announcement.email}"/></span></div><p><c:out value="${announcement.body}"/></p><small><c:out value="${announcement.created_at}"/></small></article></c:forEach></div></section></c:if>

    <c:if test="${view=='my-jobs'}"><section class="recruiter-panel"><div class="workspace-heading"><div><p class="eyebrow">YOUR LISTINGS</p><h2>Posted jobs</h2><p>Open any job to view and edit its details.</p></div><a class="workspace-button" href="${pageContext.request.contextPath}/recruiter?section=post-job">＋ Post a job</a></div>
      <div class="workspace-job-list"><c:forEach items="${companyJobs}" var="job"><article class="workspace-job"><div class="workspace-job-top"><div><h3><a href="${pageContext.request.contextPath}/recruiter?section=job-detail&amp;jobId=${job.id}"><c:out value="${job.title}"/></a></h3><div class="workspace-job-meta"><span><c:out value="${job.jobType}"/></span><span><c:out value="${job.careerField}"/></span><span><c:out value="${job.status}"/></span></div><p><c:out value="${job.location}"/> <c:if test="${not empty job.packageCtc}">· <c:out value="${job.packageCtc}"/></c:if></p><p><c:out value="${job.applicationCount}"/> applicants · <c:out value="${job.selectedCount}"/> selected · Deadline <c:out value="${job.lastDate}"/></p></div><div class="workspace-actions"><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter?section=job-detail&amp;jobId=${job.id}">View / edit</a><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter?section=applicant-list&amp;jobId=${job.id}">Applicants (<c:out value="${job.applicationCount}"/>)</a><form class="workspace-delete" method="post" action="${pageContext.request.contextPath}/recruiter" onsubmit="return confirm('Remove this job from your active listings? Applicant history will be retained.');"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="action" value="delete-job"><input type="hidden" name="jobId" value="${job.id}"><button class="workspace-button danger" type="submit">Delete</button></form></div></div></article></c:forEach>
      <c:if test="${empty companyJobs}"><div class="workspace-empty">You have not posted any jobs yet. Use “Post a job” to create your first listing.</div></c:if></div>
    </section></c:if>

    <c:if test="${view=='job-detail' and not empty job}"><section class="recruiter-panel content-card"><div class="workspace-heading"><div><p class="eyebrow">JOB LISTING · <c:out value="${job.status}"/></p><h2><c:out value="${job.title}"/></h2><p><c:out value="${job.applicationCount}"/> applicants · <c:out value="${job.jobType}"/></p></div><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter?section=applicant-list&amp;jobId=${job.id}">View applicants</a></div>
      <form method="post" action="${pageContext.request.contextPath}/recruiter"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="action" value="update-job"><input type="hidden" name="jobId" value="${job.id}">
        <div class="job-form-grid"><label>Job title<input name="title" maxlength="180" value="<c:out value='${job.title}'/>" required></label><label>Job type<select name="jobType" required><option value="Internship" ${job.jobType=='Internship'?'selected':''}>Internship</option><option value="Full-time" ${job.jobType=='Full-time'?'selected':''}>Full-time</option></select></label>
          <label>Career field<select name="careerField" required><c:forEach items="${careerFields}" var="field"><option value="${field}" ${job.careerField==field?'selected':''}><c:out value="${field}"/></option></c:forEach></select></label><label>Package / CTC<input name="packageCtc" maxlength="180" value="<c:out value='${job.packageCtc}'/>" placeholder="e.g. ₹8–12 LPA"></label>
          <label>Job location<input name="location" maxlength="180" value="<c:out value='${job.location}'/>" required></label><label>Application deadline<input name="lastDate" type="date" min="<%= java.time.LocalDate.now() %>" value="<c:out value='${job.lastDate}'/>" required></label>
          <label class="field-wide">Job description<textarea name="description" rows="9" required><c:out value="${job.description}"/></textarea></label></div>
        <div class="job-edit-toolbar"><span class="status-note">Saving edits keeps the job’s current review status.</span><div class="workspace-actions"><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter?section=my-jobs">Back to My Jobs</a><button class="workspace-button" type="submit">Save changes</button></div></div>
      </form>
    </section></c:if>

    <c:if test="${view=='applicants'}"><section class="recruiter-panel"><div class="workspace-heading"><div><p class="eyebrow">HIRING WORKSPACE</p><h2>Select a job</h2><p>Applicants are grouped under the job they applied to.</p></div></div><div class="workspace-job-list"><c:forEach items="${companyJobs}" var="job"><article class="workspace-job"><div class="workspace-job-top"><div><h3><a href="${pageContext.request.contextPath}/recruiter?section=applicant-list&amp;jobId=${job.id}"><c:out value="${job.title}"/></a></h3><div class="workspace-job-meta"><span><c:out value="${job.status}"/></span><span><c:out value="${job.location}"/></span><span><c:out value="${job.selectedCount}"/> selected</span></div></div><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter?section=applicant-list&amp;jobId=${job.id}">View applicants (<c:out value="${job.applicationCount}"/>)</a></div></article></c:forEach><c:if test="${empty companyJobs}"><div class="workspace-empty">No job listings are available yet.</div></c:if></div></section></c:if>

    <c:if test="${view=='selected-applicants' and empty job}"><section class="recruiter-panel"><div class="workspace-heading"><div><p class="eyebrow">HIRING WORKSPACE</p><h2>Select a job</h2><p>Selected applicants are people you accepted into the in-progress stage or marked as hired.</p></div></div><div class="workspace-job-list"><c:forEach items="${companyJobs}" var="listedJob"><article class="workspace-job"><div class="workspace-job-top"><div><h3><a href="${pageContext.request.contextPath}/recruiter?section=selected-applicants&amp;jobId=${listedJob.id}"><c:out value="${listedJob.title}"/></a></h3><div class="workspace-job-meta"><span><c:out value="${listedJob.status}"/></span><span><c:out value="${listedJob.selectedCount}"/> selected</span></div></div><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter?section=selected-applicants&amp;jobId=${listedJob.id}">View selected applicants</a></div></article></c:forEach><c:if test="${empty companyJobs}"><div class="workspace-empty">Post a job before managing selected applicants.</div></c:if></div></section></c:if>

    <c:if test="${view=='selected-applicants' and not empty job}"><section class="recruiter-panel"><div class="workspace-heading"><div><p class="eyebrow">SELECTED APPLICANTS FOR</p><h2><c:out value="${job.title}"/></h2><p><c:out value="${selectedApplicants.size()}"/> selected · Selection status: in progress</p></div><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter?section=selected-applicants">All selected jobs</a></div>
      <c:if test="${not empty selectedApplicants}"><form class="selected-message-form" method="post" action="${pageContext.request.contextPath}/recruiter" onsubmit="return confirm('Send this message to all selected applicants for this job?');"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="action" value="send-selected-message"><input type="hidden" name="jobId" value="${job.id}"><label for="selected-message">Message all <c:out value="${selectedApplicants.size()}"/> selected applicants</label><p>This announcement will be added to each selected seeker’s Job.com application chat.</p><textarea id="selected-message" name="message" maxlength="2000" required placeholder="Share the next steps, interview schedule, or other update for your selected applicants."></textarea><button class="workspace-button" type="submit">Send to all selected applicants</button></form>
      <div class="workspace-job-list"><c:forEach items="${selectedApplicants}" var="applicant"><article class="applicant-card"><div><h3><a href="${pageContext.request.contextPath}/recruiter?section=applicant-detail&amp;jobId=${job.id}&amp;applicationId=${applicant.applicationId}"><c:out value="${applicant.name}"/></a></h3><p><c:out value="${applicant.headline}"/></p><p><c:out value="${applicant.careerField}"/> · Accepted <c:out value="${applicant.acceptedAt}"/></p></div><div class="workspace-actions"><span class="status-pill"><c:out value="${applicant.statusLabel}"/></span><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter?section=applicant-detail&amp;jobId=${job.id}&amp;applicationId=${applicant.applicationId}">View applicant</a><c:choose><c:when test="${applicant.status=='HIRED'}"><button class="workspace-button status-hired" type="button" disabled aria-pressed="true">Hired</button></c:when><c:otherwise><form method="post" action="${pageContext.request.contextPath}/recruiter" onsubmit="return confirm('Mark this accepted applicant as hired?');"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="action" value="update-applicant"><input type="hidden" name="jobId" value="${job.id}"><input type="hidden" name="applicationId" value="${applicant.applicationId}"><input type="hidden" name="status" value="HIRED"><button class="workspace-button status-hired" type="submit">Mark as hired</button></form></c:otherwise></c:choose></div></article></c:forEach></div></c:if>
      <c:if test="${empty selectedApplicants}"><div class="workspace-empty">No one has been selected for this job yet. Accept an applicant from the Applicants section to add them here.</div></c:if>
    </section></c:if>

    <c:if test="${view=='applicant-list' and not empty job}"><section class="recruiter-panel"><div class="workspace-heading"><div><p class="eyebrow">APPLICANTS FOR</p><h2><c:out value="${job.title}"/></h2><p><c:out value="${job.applicationCount}"/> total applicants · <c:out value="${job.status}"/></p></div><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter?section=applicants">All applicant jobs</a></div>
      <c:forEach items="${applicants}" var="applicant"><article class="applicant-card"><div><h3><a href="${pageContext.request.contextPath}/recruiter?section=applicant-detail&amp;jobId=${job.id}&amp;applicationId=${applicant.applicationId}"><c:out value="${applicant.name}"/></a></h3><p><c:out value="${applicant.headline}"/></p><p><c:out value="${applicant.careerField}"/> · <c:out value="${applicant.appliedAt}"/></p></div><div class="workspace-actions"><span class="status-pill"><c:out value="${applicant.statusLabel}"/></span><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter?section=applicant-detail&amp;jobId=${job.id}&amp;applicationId=${applicant.applicationId}">View applicant</a></div></article></c:forEach>
      <c:if test="${empty applicants}"><div class="workspace-empty">No applicants for this job yet. New applications will appear here.</div></c:if>
    </section></c:if>

    <c:if test="${view=='applicant-detail' and not empty applicant}"><section class="recruiter-panel content-card"><div class="workspace-heading"><div><p class="eyebrow">APPLICATION FOR <c:out value="${job.title}"/></p><h2><c:out value="${applicant.full_name}"/></h2><p><c:out value="${applicant.headline}"/> · <span class="status-pill"><c:out value="${applicant.statusLabel}"/></span></p></div><div class="workspace-actions"><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter?section=applicant-list&amp;jobId=${job.id}">Back to applicants</a><a class="workspace-button secondary" href="${pageContext.request.contextPath}/chat?applicationId=${applicant.application_id}">Open chat</a><c:if test="${not empty applicant.resume_path}"><a class="workspace-button secondary" href="${pageContext.request.contextPath}/recruiter/application-resume?applicationId=${applicant.application_id}">Download resume</a></c:if></div></div>
      <div class="applicant-detail-grid"><div><span>Email</span><strong><c:out value="${applicant.email}"/></strong></div><div><span>Phone</span><strong><c:out value="${applicant.phone}"/></strong></div><div><span>Date of birth</span><strong><c:out value="${applicant.date_of_birth}"/></strong></div><div><span>Career field</span><strong><c:out value="${applicant.career_field}"/></strong></div><div><span>Qualification</span><strong><c:out value="${applicant.qualification}"/></strong></div><div><span>Experience</span><strong><c:out value="${applicant.experience_years}"/> years</strong></div><div class="field-wide"><span>Skills</span><strong><c:out value="${applicant.skills}"/></strong></div><div class="field-wide"><span>Profile summary</span><strong><c:out value="${applicant.profile_summary}"/></strong></div><div><span>LinkedIn</span><strong><c:if test="${not empty applicant.linkedin_url}"><a href="<c:out value='${applicant.linkedin_url}'/>" target="_blank" rel="noopener noreferrer"><c:out value="${applicant.linkedin_url}"/></a></c:if></strong></div><div><span>Portfolio</span><strong><c:if test="${not empty applicant.portfolio_url}"><a href="<c:out value='${applicant.portfolio_url}'/>" target="_blank" rel="noopener noreferrer"><c:out value="${applicant.portfolio_url}"/></a></c:if></strong></div><div class="field-wide"><span>Address</span><strong><c:out value="${applicant.address}"/><c:if test="${not empty applicant.city}">, <c:out value="${applicant.city}"/></c:if><c:if test="${not empty applicant.state}">, <c:out value="${applicant.state}"/></c:if><c:if test="${not empty applicant.postal_code}"> <c:out value="${applicant.postal_code}"/></c:if></strong></div><div><span>Applied</span><strong><c:out value="${applicant.applied_at}"/></strong></div></div>
      <div class="applicant-actions"><c:if test="${applicant.application_status!='INPROCESS' and applicant.application_status!='IN_PROGRESS' and applicant.application_status!='ACCEPTED' and applicant.application_status!='HIRED'}"><form method="post" action="${pageContext.request.contextPath}/recruiter"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="action" value="update-applicant"><input type="hidden" name="jobId" value="${job.id}"><input type="hidden" name="applicationId" value="${applicant.application_id}"><input type="hidden" name="status" value="INPROCESS"><button class="workspace-button status-accept" type="submit">Accept applicant · move to selected</button></form></c:if><c:if test="${applicant.application_status=='INPROCESS' or applicant.application_status=='IN_PROGRESS' or applicant.application_status=='ACCEPTED'}"><button class="workspace-button status-accept" type="button" disabled aria-pressed="true">Accepted · in progress</button></c:if>
        <c:if test="${applicant.application_status!='REJECTED' and applicant.application_status!='HIRED'}"><form method="post" action="${pageContext.request.contextPath}/recruiter" onsubmit="return confirm('Reject this applicant?');"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="action" value="update-applicant"><input type="hidden" name="jobId" value="${job.id}"><input type="hidden" name="applicationId" value="${applicant.application_id}"><input type="hidden" name="status" value="REJECTED"><button class="workspace-button status-reject" type="submit">Reject applicant</button></form></c:if>
        <c:if test="${applicant.application_status=='INPROCESS' or applicant.application_status=='IN_PROGRESS' or applicant.application_status=='ACCEPTED'}"><form method="post" action="${pageContext.request.contextPath}/recruiter" onsubmit="return confirm('Mark this accepted applicant as hired?');"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="action" value="update-applicant"><input type="hidden" name="jobId" value="${job.id}"><input type="hidden" name="applicationId" value="${applicant.application_id}"><input type="hidden" name="status" value="HIRED"><button class="workspace-button status-hired" type="submit">Mark as hired</button></form></c:if><c:if test="${applicant.application_status=='HIRED'}"><button class="workspace-button status-hired" type="button" disabled aria-pressed="true">Hired</button></c:if>
      </div>
    </section></c:if>

    <c:if test="${view=='profile'}"><section class="recruiter-columns single-column"><article class="content-card recruiter-profile" id="company"><div class="section-heading"><div><p class="eyebrow">COMPANY RECORD</p><h2>Company profile</h2></div><span class="status-pill"><c:out value="${profile.status}"/></span></div>
      <dl class="company-details"><div><dt>Company</dt><dd><c:out value="${profile.name}"/></dd></div><div><dt>Legal name</dt><dd><c:out value="${profile.legal_name}"/></dd></div><div><dt>Company email</dt><dd><c:out value="${profile.email}"/></dd></div><div><dt>Recruiter contact</dt><dd><c:out value="${profile.contact_person}"/></dd></div><div><dt>Contact title</dt><dd><c:out value="${profile.contact_title}"/></dd></div><div><dt>Phone</dt><dd><c:out value="${profile.phone}"/></dd></div><div><dt>Industry / size</dt><dd><c:out value="${profile.industry}"/> <c:if test="${not empty profile.company_size}">· <c:out value="${profile.company_size}"/></c:if></dd></div><div><dt>Website</dt><dd><c:out value="${profile.website}"/></dd></div><div><dt>Business license</dt><dd><c:out value="${profile.license_number}"/> <c:if test="${not empty profile.license_type}">· <c:out value="${profile.license_type}"/></c:if></dd></div><div><dt>Registration number</dt><dd><c:out value="${profile.company_registration_number}"/></dd></div><div class="company-detail-wide"><dt>Address</dt><dd><c:out value="${profile.address}"/><c:if test="${not empty profile.city}">, <c:out value="${profile.city}"/></c:if><c:if test="${not empty profile.state}">, <c:out value="${profile.state}"/></c:if><c:if test="${not empty profile.country}">, <c:out value="${profile.country}"/></c:if><c:if test="${not empty profile.postal_code}"> <c:out value="${profile.postal_code}"/></c:if></dd></div></dl>
    </article></section></c:if>

    <c:if test="${view=='post-job'}"><section class="recruiter-columns single-column"><article class="content-card recruiter-post-card"><div class="section-heading"><div><p class="eyebrow">HIRING</p><h2>Post a job</h2></div></div><p class="form-hint">Your job listing will be sent for admin review before it appears to job seekers.</p><form method="post" action="${pageContext.request.contextPath}/recruiter"><input type="hidden" name="csrf" value="${csrf}"><label>Job title<input name="title" maxlength="180" placeholder="e.g. Java Developer" required></label><label>Job type<select name="jobType" required><option value="">Select job type</option><option value="Internship">Internship</option><option value="Full-time">Full Time</option></select></label><label>Career field<select name="careerField" required><option value="">Select the field this role belongs to</option><c:forEach items="${careerFields}" var="field"><option value="${field}"><c:out value="${field}"/></option></c:forEach></select></label><label>Package / CTC<input name="packageCtc" maxlength="180" placeholder="e.g. ₹8–12 LPA, $80,000–$95,000, or stipend"></label><label>Job location<input name="location" maxlength="180" placeholder="e.g. Bengaluru, Karnataka or Remote" required></label><label>Application deadline<input name="lastDate" type="date" min="<%= java.time.LocalDate.now() %>" required></label><label>Job description<textarea name="description" rows="8" placeholder="Describe the role, responsibilities, and qualifications" required></textarea></label><button type="submit">Submit job for review</button></form></article></section></c:if>
  </main>
</div>
</body>
</html>
