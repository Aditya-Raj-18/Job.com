<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Application chats · Job.com</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin.css?v=20261102-original-evergreen-1"><style>
.chat-layout{display:grid;grid-template-columns:minmax(250px,340px) minmax(0,1fr);gap:18px;align-items:start}.chat-list,.chat-window{background:#fff;border:1px solid #dfe5ef;border-radius:16px;overflow:hidden}.chat-list h2,.chat-window h2{margin:0;padding:18px 20px;border-bottom:1px solid #e8edf3}.chat-link{display:block;padding:15px 20px;border-bottom:1px solid #edf0f5;color:#1d3352;text-decoration:none}.chat-link:hover,.chat-link.active{background:#eef7f4}.chat-link strong,.chat-link small{display:block}.chat-link small{color:#66758b;margin-top:5px}.chat-empty{padding:22px;color:#66758b}.chat-messages{padding:20px;min-height:280px;max-height:55vh;overflow:auto;display:flex;flex-direction:column;gap:10px}.chat-message{max-width:min(78%,640px);padding:11px 14px;border-radius:13px;background:#f0f3f8;align-self:flex-start;overflow-wrap:anywhere}.chat-message.mine{background:#e3f4ed;align-self:flex-end}.chat-message small{display:block;color:#66758b;font-size:11px;margin-top:5px}.chat-form{display:flex;gap:10px;padding:16px;border-top:1px solid #e8edf3}.chat-form textarea{flex:1;min-height:52px;resize:vertical}.chat-form button{align-self:end}.chat-top{display:flex;justify-content:space-between;align-items:center;padding-right:18px}.chat-top h2{flex:1}.chat-top a{color:#197b70;text-decoration:none;font-weight:700}@media(max-width:800px){.chat-layout{grid-template-columns:1fr}}
</style></head><body><div class="shell ${isRecruiter?'':'seeker-shell seeker-shell-no-sidebar'}"><c:if test="${isRecruiter}"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/recruiter">Job<span>.com</span></a><p class="sidebar-label">COMPANY WORKSPACE</p><nav class="nav-list"><a class="nav" href="${pageContext.request.contextPath}/recruiter">Dashboard</a><a class="nav" href="${pageContext.request.contextPath}/recruiter?section=my-jobs">My jobs</a><a class="nav active" href="${pageContext.request.contextPath}/chat">Chats</a></nav><div class="sidebar-bottom"><strong><c:out value="${sessionScope.companyName}"/></strong></div></aside></c:if><main class="main"><c:if test="${not isRecruiter}"><%@ include file="seeker/account-menu.jspf" %></c:if><header class="page-header"><div><p class="eyebrow">JOB.COM / APPLICATIONS</p><h1>Chats</h1><p class="page-subtitle">Private conversations are available only for submitted applications.</p></div></header><c:if test="${not empty error}"><div class="alert"><c:out value="${error}"/></div></c:if><c:if test="${not empty sessionScope.chatFlash}"><div class="alert"><c:out value="${sessionScope.chatFlash}"/></div><c:remove var="chatFlash" scope="session"/></c:if>
<div class="chat-layout"><section class="chat-list"><h2>Applications</h2><c:forEach items="${chats}" var="item"><a class="chat-link ${conversation.applicationId==item.applicationId?'active':''}" href="${pageContext.request.contextPath}/chat?applicationId=${item.applicationId}"><strong><c:out value="${item.jobTitle}"/></strong><small><c:out value="${item.otherParty}"/> · <c:out value="${item.status}"/></small></a></c:forEach><c:if test="${empty chats}"><div class="chat-empty">No chats yet. Apply to a job first to open a conversation with its recruiter.</div></c:if></section>
<section class="chat-window"><c:choose><c:when test="${not empty conversation}"><div class="chat-top"><h2><c:out value="${conversation.jobTitle}"/> <small>· <c:out value="${isRecruiter?conversation.seekerName:conversation.companyName}"/></small></h2><a href="${pageContext.request.contextPath}/chat">Close</a></div><div class="chat-messages" id="messages"><c:forEach items="${messages}" var="message"><div class="chat-message ${message.senderId==currentAccountId?'mine':''}"><c:out value="${message.body}"/><small><c:out value="${message.senderType=='SEEKER'?conversation.seekerName:conversation.companyName}"/> · <c:out value="${message.created}"/></small></div></c:forEach><c:if test="${empty messages}"><div class="chat-empty">Application submitted. Send a message to start the conversation.</div></c:if></div><form class="chat-form" method="post" action="${pageContext.request.contextPath}/chat"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="applicationId" value="${conversation.applicationId}"><textarea name="body" maxlength="4000" placeholder="Write a message…" required></textarea><button type="submit">Send</button></form></c:when><c:otherwise><div class="chat-empty">Choose an application to open its conversation. A chat is created only after the seeker applies.</div></c:otherwise></c:choose></section></div></main></div><script>const box=document.getElementById('messages');if(box)box.scrollTop=box.scrollHeight;</script></body></html>
